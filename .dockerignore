# Keep the build context small and, more importantly, keep local state and
# secrets out of the image.

.git
.github
.venv
venv
env
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.coverage
htmlcov

# Local databases, uploads and shares. Baking a dev database into the image
# would ship real accounts to the registry.
app/data
app/shares
app/static/uploads
*.db
*.log

# Credentials and local launchers.
.env
.env.*
run-firebase.ps1
run-firebase.sh
serviceAccountKey*.json
firebase-adminsdk*.json
*-firebase-adminsdk-*.json

# Not needed at runtime.
tests
docs
scripts
*.md
!README.md
Reveal-X_FYP*.pdf
*.pptx
.vscode
.idea
.DS_Store
Thumbs.db
