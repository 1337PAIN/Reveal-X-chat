# Virtual Environment
venv/
env/
ENV/

# Python
__pycache__/
.pytest_cache/
# Coverage output. .coverage was committed once and then rewritten by every
# local run, so it showed up as a change in every diff.
.coverage
.coverage.*
htmlcov/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database
*.db
app/data/

# Uploads
app/static/uploads/
app/shares/

# Firebase service-account keys - never commit these
serviceAccountKey*.json
firebase-adminsdk*.json
*-firebase-adminsdk-*.json

# Environment variables
.env
.env.local
# Local launcher carrying the Firebase web config. Those values are public, but
# GitHub's secret scanner flags AIza... keys, so keep it out of commits.
run-firebase.ps1
run-firebase.sh

# Logs
*.log

# Local environments
.venv/
.env.production

# Browser end-to-end tests: npm install output and screenshots
tests/e2e/node_modules/
tests/e2e/artifacts/

# Keys generated by scripts/run_windows_server.ps1, and optional Firebase settings
.server-secrets.ps1
firebase.local.ps1
